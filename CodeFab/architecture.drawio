      <mxCell id="IF_Opt" value="«interface» OptimizerInterface&#10;«from Checker»" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=0;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
        <mxGeometry x="420" y="1060" width="300" height="46" as="geometry"/>
      </mxCell>
      <mxCell id="IF_Opt_r1" value="+ optimize(tree): void" style="text;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;html=1;" vertex="1" parent="IF_Opt">
