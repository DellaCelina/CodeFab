          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="callout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=2;align=left;verticalAlign=top;spacing=8;" value="Design pattern: Visitor (GoF) for the interpretation loop - Executor is a SyntaxNodeVisitor, exactly like Checker/Optimizer (see tab 10), just performing evaluation instead of checking/folding. The superclass method-lookup walk (findMethod + resolveSuperclass looping until found or root reached) is a linear chain search reminiscent of Chain-of-Responsibility, applied here to single inheritance rather than an object graph. Splitting Executor into ClassRuntime/ModuleRuntime/ArrayRuntime collaborators (each holding a back-reference to the owning Executor) is a Facade-style decomposition: Executor stays the single entry point (ExecuteInterface) while delegating cohesive chunks of behavior to focused helper classes." vertex="1">
          <mxGeometry height="130" width="1900" x="40" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="a1vdzDbE75psPdKxKN9G-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 24px;&quot;&gt;발표에 포함 X (Appendix)&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="1250" x="1340" y="10" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="12. Shell - Debugger Hook Flow" id="tab-shell-debugger-flow">
    <mxGraphModel dx="1813" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1_title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;" value="Section 1: Wiring the hook (setup phase)" vertex="1">
          <mxGeometry height="30" width="500" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="p_main" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontStyle=1;" value="main" vertex="1">
          <mxGeometry height="50" width="180" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p_debugmode" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontStyle=1;" value="DebugMode" vertex="1">
          <mxGeometry height="50" width="220" x="330" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p_debugger" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontStyle=1;" value="Debugger" vertex="1">
          <mxGeometry height="50" width="220" x="680" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p_executor" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontStyle=1;" value="Executor" vertex="1">
          <mxGeometry height="50" width="220" x="1030" y="60" as="geometry" />
        </mxCell>
        <mxCell id="s1_box2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;spacing=6;" value="2: tokenize -&gt; assemble -&gt; check -&gt; optimize&#xa;(same 5-stage pipeline as FileRunMode, see tab 08)" vertex="1">
          <mxGeometry height="80" width="220" x="330" y="150" as="geometry" />
        </mxCell>
        <mxCell id="e1_1" edge="1" parent="1" source="p_main" style="endArrow=block;html=1;fontColor=#333333;" target="p_debugmode" value="1: DebugMode(tokenizer, assembler, checker, optimizer, executor)&#xa;.run(filePath, in, out)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_2" edge="1" parent="1" source="p_debugmode" style="endArrow=block;html=1;fontColor=#333333;dashed=1;" target="s1_box2" value="2: internal pipeline call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_3" edge="1" parent="1" source="p_debugmode" style="endArrow=block;html=1;fontColor=#333333;" target="p_debugger" value="3: new Debugger(executor, in, out, sourceLines)&#xa;-- constructed with the FILE&#39;s source lines for printing context,&#xa;and the debug session&#39;s OWN in/out streams&#xa;(separate from the program&#39;s print output stream)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_4" edge="1" parent="1" source="p_debugmode" style="endArrow=block;html=1;fontColor=#333333;" target="p_executor" value="4: executor.setStatementHook( [&amp;](stmt, depth){ debugger.onStatement(stmt, depth); } )&#xa;-- requires the CONCRETE Executor type because setStatementHook&#xa;is not part of ExecuteInterface">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1_5" edge="1" parent="1" source="p_debugmode" style="endArrow=block;html=1;fontColor=#333333;" target="p_executor" value="5: executor.execute(tree)&#xa;-- hands off control; from here the hook drives everything">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2_title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;" value="Section 2: Per-statement pause/resume loop (the hook in action)" vertex="1">
          <mxGeometry height="30" width="600" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="Executor::execute(Statement* stmt)&#xa;about to run the next statement" vertex="1">
          <mxGeometry height="60" width="260" x="60" y="410" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;" value="statementHook_(stmt, depth) invoked&#xa;BEFORE the statement executes --&#xa;Debugger::onStatement(stmt, depth)" vertex="1">
          <mxGeometry height="70" width="260" x="60" y="500" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" value="shouldStop(stmt, depth)?" vertex="1">
          <mxGeometry height="90" width="220" x="80" y="610" as="geometry" />
        </mxCell>
        <mxCell id="n4a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="Mode == Step:&#xa;always true -- stop on&#xa;every statement" vertex="1">
          <mxGeometry height="70" width="230" x="380" y="600" as="geometry" />
        </mxCell>
        <mxCell id="n4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="Mode == Next:&#xa;true only if depth &lt;= nextTargetDepth_ --&#xa;implements step-OVER (skip into function/&#xa;method calls, i.e. deeper depth, without stopping)" vertex="1">
          <mxGeometry height="90" width="230" x="380" y="690" as="geometry" />
        </mxCell>
        <mxCell id="n4c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="Mode == Continue:&#xa;true only if stmt-&gt;containsLine(line)&#xa;matches a breakpoint in breakpoints_" vertex="1">
          <mxGeometry height="80" width="230" x="380" y="800" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" value="did shouldStop return true?" vertex="1">
          <mxGeometry height="90" width="220" x="680" y="690" as="geometry" />
        </mxCell>
        <mxCell id="n6no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;" value="No: return immediately --&#xa;Executor proceeds to&#xa;stmt-&gt;accept(*this), no pause" vertex="1">
          <mxGeometry height="70" width="240" x="960" y="600" as="geometry" />
        </mxCell>
        <mxCell id="n6yes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;" value="Yes: printCurrentSourceLine(stmt&#39;s line)&#xa;+ printWatches() -- show context" vertex="1">
          <mxGeometry height="70" width="240" x="960" y="700" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;" value="promptAndHandleCommand(stmt, depth) --&#xa;blocks reading from in_ until the user&#xa;issues a recognized command" vertex="1">
          <mxGeometry height="80" width="240" x="960" y="800" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" value="which command?" vertex="1">
          <mxGeometry height="100" width="220" x="980" y="920" as="geometry" />
        </mxCell>
        <mxCell id="n9step" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;" value="step: mode_ = Step; return control&#xa;to Executor (runs exactly this one&#xa;statement, will stop again next statement)" vertex="1">
          <mxGeometry height="80" width="240" x="60" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="n9next" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;" value="next: mode_ = Next; nextTargetDepth_ = depth;&#xa;return control (won&#39;t stop again until&#xa;back at this depth or shallower)" vertex="1">
          <mxGeometry height="80" width="240" x="320" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="n9cont" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacing=6;" value="continue: mode_ = Continue;&#xa;return control (runs freely until&#xa;a breakpoint line is hit)" vertex="1">
          <mxGeometry height="80" width="240" x="580" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="n9break" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;" value="break &lt;line&gt;: breakpoints_.insert(line);&#xa;loop back to promptAndHandleCommand&#xa;(stay paused, wait for next command)" vertex="1">
          <mxGeometry height="80" width="240" x="840" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="n9watch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;" value="watch &lt;name&gt;: watches_.push_back(name);&#xa;loop back to promptAndHandleCommand" vertex="1">
          <mxGeometry height="80" width="240" x="1100" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="n9inspect" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacing=6;" value="inspect: printInspect() reads&#xa;executor_.environment().scopes() and&#xa;Scope::variables() to dump current variable&#xa;bindings; loop back to promptAndHandleCommand" vertex="1">
          <mxGeometry height="100" width="260" x="1360" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="n10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="control returns to Executor::execute(stmt),&#xa;which now calls stmt-&gt;accept(*this)&#xa;to actually run the statement" vertex="1">
          <mxGeometry height="80" width="500" x="60" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="f1" edge="1" parent="1" source="n1" style="endArrow=block;html=1;fontColor=#333333;" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2" edge="1" parent="1" source="n2" style="endArrow=block;html=1;fontColor=#333333;" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3a" edge="1" parent="1" source="n3" style="endArrow=block;html=1;fontColor=#333333;" target="n4a" value="Step mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3b" edge="1" parent="1" source="n3" style="endArrow=block;html=1;fontColor=#333333;" target="n4b" value="Next mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f3c" edge="1" parent="1" source="n3" style="endArrow=block;html=1;fontColor=#333333;" target="n4c" value="Continue mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4a" edge="1" parent="1" source="n4a" style="endArrow=block;html=1;fontColor=#333333;" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4b" edge="1" parent="1" source="n4b" style="endArrow=block;html=1;fontColor=#333333;" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f4c" edge="1" parent="1" source="n4c" style="endArrow=block;html=1;fontColor=#333333;" target="n5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5no" edge="1" parent="1" source="n5" style="endArrow=block;html=1;fontColor=#333333;" target="n6no" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f5yes" edge="1" parent="1" source="n5" style="endArrow=block;html=1;fontColor=#333333;" target="n6yes" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f6" edge="1" parent="1" source="n6yes" style="endArrow=block;html=1;fontColor=#333333;" target="n7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f7" edge="1" parent="1" source="n7" style="endArrow=block;html=1;fontColor=#333333;" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8step" edge="1" parent="1" source="n8" style="endArrow=block;html=1;fontColor=#333333;" target="n9step" value="step">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8next" edge="1" parent="1" source="n8" style="endArrow=block;html=1;fontColor=#333333;" target="n9next" value="next">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8cont" edge="1" parent="1" source="n8" style="endArrow=block;html=1;fontColor=#333333;" target="n9cont" value="continue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8break" edge="1" parent="1" source="n8" style="endArrow=block;html=1;fontColor=#333333;" target="n9break" value="break &lt;line&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8watch" edge="1" parent="1" source="n8" style="endArrow=block;html=1;fontColor=#333333;" target="n9watch" value="watch &lt;name&gt;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f8inspect" edge="1" parent="1" source="n8" style="endArrow=block;html=1;fontColor=#333333;" target="n9inspect" value="inspect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f9breakloop" edge="1" parent="1" source="n9break" style="endArrow=block;html=1;fontColor=#333333;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" target="n7" value="loop back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f9watchloop" edge="1" parent="1" source="n9watch" style="endArrow=block;html=1;fontColor=#333333;dashed=1;exitX=0;exitY=0;entryX=1;entryY=0.3;" target="n7" value="loop back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f9inspectloop" edge="1" parent="1" source="n9inspect" style="endArrow=block;html=1;fontColor=#333333;dashed=1;exitX=0;exitY=0;entryX=1;entryY=0.6;" target="n7" value="loop back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f10" edge="1" parent="1" source="n9step" style="endArrow=block;html=1;fontColor=#333333;" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f10b" edge="1" parent="1" source="n9next" style="endArrow=block;html=1;fontColor=#333333;" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f10c" edge="1" parent="1" source="n9cont" style="endArrow=block;html=1;fontColor=#333333;" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f10d" edge="1" parent="1" source="n6no" style="endArrow=block;html=1;fontColor=#333333;" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3_title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;" value="Section 3: Example timeline" vertex="1">
          <mxGeometry height="30" width="400" x="1150" y="360" as="geometry" />
        </mxCell>
        <mxCell id="ex1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=left;verticalAlign=top;spacing=8;" value="source:&#xa;1: var x = 1;&#xa;2: func add(a, b) { return a + b; }&#xa;3: var y = add(x, 2);&#xa;4: print y;&#xa;&#xa;debug session (Step mode from start):&#xa;&gt; stop at line 1 (depth 0)     -- user types: next&#xa;&gt; stop at line 3 (depth 0)     -- (line 2 is a declaration, no call yet;&#xa;                                   &quot;next&quot; at depth 0 skips over it)&#xa;                                -- user types: step&#xa;&gt; stop at line 3, entering add() call (depth 1)&#xa;                                -- Step mode always stops, even one level deeper&#xa;                                -- user types: continue&#xa;&gt; program runs to completion (no breakpoints set) -- prints &quot;3&quot;" vertex="1">
          <mxGeometry height="300" width="810" x="1150" y="400" as="geometry" />
        </mxCell>
        <mxCell id="callout1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=2;align=left;verticalAlign=top;spacing=8;" value="Design pattern: Observer / Hook (callback injection). Executor exposes a single extension point -- statementHook_ -- without knowing anything about Debugger; DebugMode wires the two together at the Shell layer, so the core interpreter stays completely decoupled from debugging concerns (RunPromptShell and FileRunMode never set a hook at all). Debugger::Mode (Step/Next/Continue) acting as three different shouldStop() decision rules is a small Strategy-pattern flavor: the same onStatement() call is interpreted differently depending on which mode is currently active." vertex="1">
          <mxGeometry height="120" width="1920" x="40" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="T1Bie0B-qkgG2yldmkXE-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 24px;&quot;&gt;발표에 포함 X (Appendix)&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="1250" x="630" y="285" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
