      <!-- ===================== SECTION 3: Example timeline ===================== -->
      <mxCell id="s3_title" value="Section 3: Example timeline" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1">
        <mxGeometry x="1150" y="360" width="400" height="30" as="geometry" />
      </mxCell>
      <mxCell id="ex1" value="source:&#10;1: var x = 1;&#10;2: func add(a, b) { return a + b; }&#10;3: var y = add(x, 2);&#10;4: print y;&#10;&#10;debug session (Step mode from start):&#10;&gt; stop at line 1 (depth 0)     -- user types: next&#10;&gt; stop at line 3 (depth 0)     -- (line 2 is a declaration, no call yet;&#10;                                   &quot;next&quot; at depth 0 skips over it)&#10;                                -- user types: step&#10;&gt; stop at line 3, entering add() call (depth 1)&#10;                                -- Step mode always stops, even one level deeper&#10;                                -- user types: continue&#10;&gt; program runs to completion (no breakpoints set) -- prints &quot;3&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
        <mxGeometry x="1150" y="400" width="810" height="300" as="geometry" />
      </mxCell>

      <!-- ===================== Design pattern callout ===================== -->
      <mxCell id="callout1" value="Design pattern: Observer / Hook (callback injection). Executor exposes a single extension point -- statementHook_ -- without knowing anything about Debugger; DebugMode wires the two together at the Shell layer, so the core interpreter stays completely decoupled from debugging concerns (RunPromptShell and FileRunMode never set a hook at all). Debugger::Mode (Step/Next/Continue) acting as three different shouldStop() decision rules is a small Strategy-pattern flavor: the same onStatement() call is interpreted differently depending on which mode is currently active." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=2;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
        <mxGeometry x="40" y="1300" width="1920" height="120" as="geometry" />
      </mxCell>

    </root>
  </mxGraphModel>
</diagram>
</mxfile>
