        <mxCell id="p_or" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="logicOr()&#xa;calls logicAnd(); while match(OR): wrap left in OrExpression, parse right via logicAnd(), loop" vertex="1">
          <mxGeometry height="70" width="700" x="100" y="240" as="geometry" />
        </mxCell>
        <mxCell id="p_and" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="logicAnd()&#xa;calls equality(); while match(AND): wrap in AndExpression, loop" vertex="1">
          <mxGeometry height="70" width="700" x="100" y="340" as="geometry" />
        </mxCell>
        <mxCell id="p_eq" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="equality()&#xa;calls comparison(); while match(==,!=): wrap in Equal/NotEqualExpression, loop" vertex="1">
          <mxGeometry height="70" width="700" x="100" y="440" as="geometry" />
        </mxCell>
        <mxCell id="p_cmp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="comparison()&#xa;calls term(); while match(&lt;,&lt;=,&gt;,&gt;=): wrap in Less/Greater(Equal)Expression, loop" vertex="1">
          <mxGeometry height="70" width="700" x="100" y="540" as="geometry" />
        </mxCell>
        <mxCell id="p_term" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="term()&#xa;calls factor(); while match(+,-): wrap in Add/SubExpression, loop" vertex="1">
          <mxGeometry height="70" width="700" x="100" y="640" as="geometry" />
        </mxCell>
        <mxCell id="p_factor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="factor()&#xa;calls unary(); while match(*,/,%): wrap in Mult/Divide/ModExpression, loop" vertex="1">
          <mxGeometry height="70" width="700" x="100" y="740" as="geometry" />
        </mxCell>
        <mxCell id="p_unary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="unary()&#xa;if match(-,!): parse operand via unary() (recursive, handles --x), build Negative/NotExpression; else falls through to call()" vertex="1">
          <mxGeometry height="70" width="700" x="100" y="840" as="geometry" />
        </mxCell>
        <mxCell id="p_call" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="call()&#xa;parses primary(); while match(&#39;(&#39; or &#39;.&#39;): wrap in CallExpression (args) or FieldAccessExpression (.name), loop -- handles chained a.b().c[i]" vertex="1">
          <mxGeometry height="70" width="700" x="100" y="940" as="geometry" />
        </mxCell>
        <mxCell id="p_primary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="primary()&#xa;leaf: NUMBER/STRING/TRUE/FALSE/THIS/SUPER literal, IDENTIFIER, &#39;(&#39; expression &#39;)&#39; grouping, ARRAY[size], or &#39;new&#39; Class() via CallExpression" vertex="1">
          <mxGeometry height="70" width="700" x="100" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="e_1" edge="1" parent="1" source="p_expr" style="endArrow=block;html=1;fontColor=#333333;" target="p_assign" value="1: calls assignment()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_2" edge="1" parent="1" source="p_assign" style="endArrow=block;html=1;fontColor=#333333;" target="p_or" value="2: falls through to logicOr()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_3" edge="1" parent="1" source="p_or" style="endArrow=block;html=1;fontColor=#333333;" target="p_and" value="3: calls logicAnd()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_4" edge="1" parent="1" source="p_and" style="endArrow=block;html=1;fontColor=#333333;" target="p_eq" value="4: calls equality()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_5" edge="1" parent="1" source="p_eq" style="endArrow=block;html=1;fontColor=#333333;" target="p_cmp" value="5: calls comparison()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_6" edge="1" parent="1" source="p_cmp" style="endArrow=block;html=1;fontColor=#333333;" target="p_term" value="6: calls term()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_7" edge="1" parent="1" source="p_term" style="endArrow=block;html=1;fontColor=#333333;" target="p_factor" value="7: calls factor()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_8" edge="1" parent="1" source="p_factor" style="endArrow=block;html=1;fontColor=#333333;" target="p_unary" value="8: calls unary()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_9" edge="1" parent="1" source="p_unary" style="endArrow=block;html=1;fontColor=#333333;" target="p_call" value="9: falls through to call()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_10" edge="1" parent="1" source="p_call" style="endArrow=block;html=1;fontColor=#333333;" target="p_primary" value="10: parses primary()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="example_box" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=left;verticalAlign=top;spacing=8;" value="input: 1 + 2 * 3&#xa;term() calls factor() for left operand -&gt; sees NUMBER 1, returns NumberExpression(1)&#xa;term() sees &#39;+&#39;, calls factor() for right operand:&#xa;  factor() calls unary()-&gt;call()-&gt;primary() -&gt; NUMBER 2 -&gt; NumberExpression(2)&#xa;  factor() sees &#39;*&#39;, calls unary()-&gt;...-&gt;primary() -&gt; NUMBER 3 -&gt; NumberExpression(3)&#xa;  factor() wraps: MultExpression(2, 3)&#xa;term() wraps: AddExpression(1, MultExpression(2, 3))&#xa;=&gt; multiplication binds tighter because factor() greedily consumes it before term() ever sees the &#39;+&#39;" vertex="1">
          <mxGeometry height="220" width="700" x="100" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="B_title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;" value="Section B: Statement Parsing Dispatch" vertex="1">
          <mxGeometry height="30" width="700" x="1000" as="geometry" />
        </mxCell>
        <mxCell id="s_dispatch" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" value="statement()&#xa;dispatch on leading token" vertex="1">
          <mxGeometry height="90" width="200" x="1300" y="40" as="geometry" />
        </mxCell>
        <mxCell id="s_print" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="printStatement()&#xa;consume PRINT, parse expression(), consume &#39;;&#39;, build PrintStatement" vertex="1">
          <mxGeometry height="100" width="380" x="1020" y="200" as="geometry" />
        </mxCell>
        <mxCell id="s_if" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="ifStatement()&#xa;consume IF &#39;(&#39;, parse expression() condition, &#39;)&#39;, parse statement() as thenBranch; if match(ELSE): parse statement() as elseBranch" vertex="1">
          <mxGeometry height="100" width="380" x="1460" y="200" as="geometry" />
        </mxCell>
        <mxCell id="s_for" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="forStatement()&#xa;consume FOR &#39;(&#39;, parse init (declare or expr stmt), compare expression, &#39;;&#39;, next expression, &#39;)&#39;, parse statement() as loop body" vertex="1">
          <mxGeometry height="100" width="380" x="1020" y="320" as="geometry" />
        </mxCell>
        <mxCell id="s_block" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="block()&#xa;consume &#39;{&#39;, loop calling statement()/declaration() until &#39;}&#39;, collect into BlockStatement -- each block is its own lexical scope" vertex="1">
          <mxGeometry height="100" width="380" x="1460" y="320" as="geometry" />
        </mxCell>
        <mxCell id="s_var" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="declareStatement()&#xa;consume VAR IDENTIFIER, optional &#39;= expression()&#39;, &#39;;&#39;, build DeclareStatement" vertex="1">
          <mxGeometry height="100" width="380" x="1020" y="440" as="geometry" />
        </mxCell>
        <mxCell id="s_func" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="functionDeclaration()&#xa;consume FUNC name &#39;(&#39; params &#39;)&#39; block(), build FunctionDeclareStatement" vertex="1">
          <mxGeometry height="100" width="380" x="1460" y="440" as="geometry" />
        </mxCell>
        <mxCell id="s_class" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="classDeclaration()&#xa;consume CLASS name, optional &#39;: superclass&#39;, &#39;{&#39;, repeatedly parse method declarations (Token name + params + block, no FUNC keyword), &#39;}&#39;, build ClassDeclareStatement" vertex="1">
          <mxGeometry height="100" width="380" x="1020" y="560" as="geometry" />
        </mxCell>
        <mxCell id="s_return" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="returnStatement()&#xa;consume RETURN, optional expression() if not &#39;;&#39;, &#39;;&#39;, build ReturnStatement" vertex="1">
          <mxGeometry height="100" width="380" x="1460" y="560" as="geometry" />
        </mxCell>
        <mxCell id="s_import" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="importStatement()&#xa;consume IMPORT path &#39;alias&#39; alias, recursively assembles the imported file&#39;s tokens via sourceReader_, collects its top-level declarations, build ImportStatement" vertex="1">
          <mxGeometry height="100" width="380" x="1020" y="680" as="geometry" />
        </mxCell>
        <mxCell id="s_exprstmt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="expressionStatement()&#xa;parse expression(), consume &#39;;&#39;, build ExpressionStatement (covers assignments and bare calls like foo();)" vertex="1">
          <mxGeometry height="100" width="380" x="1460" y="680" as="geometry" />
        </mxCell>
        <mxCell id="d_print" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_print" value="1: PRINT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_if" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_if" value="2: IF">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_for" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_for" value="3: FOR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_block" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_block" value="4: LEFT_BRACE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_var" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_var" value="5: VAR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_func" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_func" value="6: FUNC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_class" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_class" value="7: CLASS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_return" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_return" value="8: RETURN">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_import" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_import" value="9: IMPORT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_exprstmt" edge="1" parent="1" source="s_dispatch" style="endArrow=block;html=1;fontColor=#333333;" target="s_exprstmt" value="10: (default, no keyword matched)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="callout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=2;align=left;verticalAlign=top;spacing=8;" value="Design pattern: Recursive Descent / Precedence Climbing. Each precedence level is a dedicated function that delegates to the next tighter-binding level before applying its own operators -- this directly encodes the grammar&#39;s precedence table into the call structure, with no explicit precedence numbers or tables needed. The resulting SyntaxNode tree is then consumed via the Visitor pattern (see tabs 05/06) -- together this is the classic Interpreter (GoF) pattern: a language&#39;s grammar is represented as a class hierarchy (the AST), and operations on it (checking, optimizing, executing) are separate Visitor objects." vertex="1">
          <mxGeometry height="140" width="1800" x="40" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="FACwQz3KVmUvOQd1RKZD-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 24px;&quot;&gt;발표에 포함 X (Appendix)&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="1250" x="1050" y="920" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="10. Checker &amp; Optimizer - Visitor Pattern" id="tab-checker-optimizer-behavior">
    <mxGraphModel dx="2538" dy="1134" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1_title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;" value="1. Visitor double-dispatch mechanism (generic to Checker / Optimizer / Executor)" vertex="1">
          <mxGeometry height="30" width="900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="p_client" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontStyle=1;" value="Client" vertex="1">
          <mxGeometry height="60" width="180" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p_tree" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontStyle=1;" value="SyntaxTree" vertex="1">
          <mxGeometry height="60" width="220" x="300" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p_node" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontStyle=1;" value="SyntaxNode&#xa;(e.g. BlockStatement)" vertex="1">
          <mxGeometry height="60" width="240" x="600" y="80" as="geometry" />
        </mxCell>
        <mxCell id="p_checker" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontStyle=1;" value="Checker&#xa;(SyntaxNodeVisitor)" vertex="1">
          <mxGeometry height="60" width="240" x="920" y="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="p_client" style="endArrow=block;html=1;fontColor=#333333;" target="p_tree" value="1: check(tree)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="p_tree" style="endArrow=block;html=1;fontColor=#333333;" target="p_node" value="2: tree.getRoot()-&gt;accept(*this)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="p_node" style="endArrow=block;html=1;fontColor=#333333;" target="p_checker" value="3: node.accept(v) calls v.visit(*this) - node&#39;s static type picks the overload">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="p_checker" style="endArrow=block;html=1;fontColor=#333333;" target="p_node" value="4: visit(BlockStatement&amp;) runs type-specific logic (enterScope, iterate children, exitScope)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="170" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="p_node" style="endArrow=block;html=1;fontColor=#333333;dashed=1;curved=1;" target="p_node" value="5: for each child stmt: stmt-&gt;accept(*this) - recurses down the tree">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="220" />
              <mxPoint x="720" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s1_why" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=left;verticalAlign=top;spacing=8;" value="Why Visitor matters:&#xa;Without Visitor: you&#39;d need a big switch/if-chain on node-&gt;type() in every operation (Checker, Optimizer, Executor), and adding a new AST node type would require editing every one of those switches.&#xa;With Visitor: SyntaxNodeVisitor declares one visit(X&amp;) per node type (compile-time exhaustive - the compiler errors if a new node type&#39;s visit() is missing), and each operation (Checker/Optimizer/Executor) is a self-contained class implementing that interface.&#xa;Adding a new operation = one new visitor class; adding a new node type = one new visit() method in each existing visitor (compiler-enforced)." vertex="1">
          <mxGeometry height="140" width="1120" x="40" y="260" as="geometry" />
        </mxCell>
        <mxCell id="s2_title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;" value="2. Checker: static-scope resolution (resolveIdentifier / IdentifierExpression::depth)" vertex="1">
          <mxGeometry height="30" width="900" x="40" y="440" as="geometry" />
        </mxCell>
        <mxCell id="s2_start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="visit(IdentifierExpression&amp; node)" vertex="1">
          <mxGeometry height="60" width="320" x="80" y="490" as="geometry" />
        </mxCell>
        <mxCell id="s2_init" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="distance = 0;&#xa;scopeIndex = scopes.size() - 1 (innermost)" vertex="1">
          <mxGeometry height="70" width="320" x="80" y="580" as="geometry" />
        </mxCell>
        <mxCell id="s2_dec" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" value="scopes[scopeIndex] contains node.name?" vertex="1">
          <mxGeometry height="100" width="300" x="90" y="690" as="geometry" />
        </mxCell>
        <mxCell id="s2_miss" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="No, and scopeIndex &gt; 0:&#xa;distance++; scopeIndex--" vertex="1">
          <mxGeometry height="80" width="280" x="440" y="700" as="geometry" />
        </mxCell>
        <mxCell id="s2_found" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="Yes:&#xa;node.depth = distance&#xa;(cached on the AST node itself, mutable optional&lt;int&gt;)" vertex="1">
          <mxGeometry height="90" width="320" x="80" y="850" as="geometry" />
        </mxCell>
        <mxCell id="s2_exhaust" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="No, and scopeIndex == 0 (exhausted all scopes):&#xa;treat as global/undeclared - checked at the outermost scope; error if truly undeclared" vertex="1">
          <mxGeometry height="100" width="360" x="440" y="850" as="geometry" />
        </mxCell>
        <mxCell id="s2_end" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="Later: Environment::lookupAt(node.depth, name)&#xa;gives O(1) access instead of walking the whole scope chain at runtime" vertex="1">
          <mxGeometry height="80" width="720" x="80" y="990" as="geometry" />
        </mxCell>
        <mxCell id="s2_e1" edge="1" parent="1" source="s2_start" style="endArrow=block;html=1;" target="s2_init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2_e2" edge="1" parent="1" source="s2_init" style="endArrow=block;html=1;" target="s2_dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2_e3" edge="1" parent="1" source="s2_dec" style="endArrow=block;html=1;" target="s2_miss" value="no, scopeIndex &gt; 0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2_e4" edge="1" parent="1" source="s2_miss" style="endArrow=block;html=1;dashed=1;" target="s2_dec" value="loop back">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="670" />
              <mxPoint x="390" y="670" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s2_e5" edge="1" parent="1" source="s2_dec" style="endArrow=block;html=1;" target="s2_found" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2_e6" edge="1" parent="1" source="s2_dec" style="endArrow=block;html=1;" target="s2_exhaust" value="no, scopeIndex == 0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2_e7" edge="1" parent="1" source="s2_found" style="endArrow=block;html=1;" target="s2_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2_e8" edge="1" parent="1" source="s2_exhaust" style="endArrow=block;html=1;" target="s2_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2_code" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=left;verticalAlign=top;spacing=8;" value="{&#xa;  var x = 1;        // declared in outer block scope&#xa;  {&#xa;    var y = 2;       // inner block scope&#xa;    print x + y;    // resolving &#39;x&#39;: not in inner scope (depth 0 miss) -&gt; found in outer scope at depth 1&#xa;                      // resolving &#39;y&#39;: found immediately in inner scope at depth 0&#xa;  }&#xa;}" vertex="1">
          <mxGeometry height="180" width="720" x="80" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="s3_title" parent="1" style="text;html=1;fontStyle=1;fontSize=16;align=left;verticalAlign=middle;" value="3. Optimizer: constant folding" vertex="1">
          <mxGeometry height="30" width="700" x="1050" y="440" as="geometry" />
        </mxCell>
        <mxCell id="s3_start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="visit(BinaryExpression&amp; node)&#xa;e.g. AddExpression" vertex="1">
          <mxGeometry height="70" width="380" x="1090" y="490" as="geometry" />
        </mxCell>
        <mxCell id="s3_left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="foldExpression(node.left)&#xa;recurse first (post-order / bottom-up)" vertex="1">
          <mxGeometry height="70" width="380" x="1090" y="590" as="geometry" />
        </mxCell>
        <mxCell id="s3_right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="foldExpression(node.right)&#xa;recurse first" vertex="1">
          <mxGeometry height="60" width="380" x="1090" y="690" as="geometry" />
        </mxCell>
        <mxCell id="s3_dec" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;" value="both node.left and node.right&#xa;are now literal nodes (Number/String/Boolean)?" vertex="1">
          <mxGeometry height="110" width="340" x="1110" y="780" as="geometry" />
        </mxCell>
        <mxCell id="s3_eval" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="Yes:&#xa;value = executor_.evaluate(&amp;node)&#xa;computes the result at compile time using the real Executor" vertex="1">
          <mxGeometry height="90" width="380" x="1090" y="930" as="geometry" />
        </mxCell>
        <mxCell id="s3_replace" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="replaceWithLiteral(node, value):&#xa;allocates a new literal SyntaxNode owned by tree_, and rewrites the PARENT&#39;s pointer to point at it&#xa;(node.left/right and BinaryExpression&#39;s own slot are non-const specifically to allow this rewrite)" vertex="1">
          <mxGeometry height="120" width="380" x="1090" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="s3_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;spacing=6;" value="No:&#xa;leave node as-is; at least one operand is still&#xa;a runtime expression (e.g. a variable)" vertex="1">
          <mxGeometry height="90" width="340" x="1520" y="800" as="geometry" />
        </mxCell>
        <mxCell id="s3_e1" edge="1" parent="1" source="s3_start" style="endArrow=block;html=1;" target="s3_left">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3_e2" edge="1" parent="1" source="s3_left" style="endArrow=block;html=1;" target="s3_right">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3_e3" edge="1" parent="1" source="s3_right" style="endArrow=block;html=1;" target="s3_dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3_e4" edge="1" parent="1" source="s3_dec" style="endArrow=block;html=1;" target="s3_eval" value="yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3_e5" edge="1" parent="1" source="s3_eval" style="endArrow=block;html=1;" target="s3_replace">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3_e6" edge="1" parent="1" source="s3_dec" style="endArrow=block;html=1;" target="s3_no" value="no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3_code" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;align=left;verticalAlign=top;spacing=8;" value="BEFORE optimize():&#xa;  AddExpression&#xa;    left:  NumberExpression(2)&#xa;    right: MultExpression&#xa;             left:  NumberExpression(3)&#xa;             right: NumberExpression(4)&#xa;&#xa;Optimizer visits bottom-up: MultExpression(3,4) folds first (both literals) -&gt; NumberExpression(12)&#xa;Then AddExpression(2, 12) folds (both literals) -&gt; NumberExpression(14)&#xa;&#xa;AFTER optimize():&#xa;  NumberExpression(14)   // entire subtree replaced by a single literal" vertex="1">
          <mxGeometry height="220" width="780" x="1090" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="callout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=2;align=left;verticalAlign=top;spacing=8;" value="Design pattern: Visitor (GoF). SyntaxNodeVisitor decouples the AST node hierarchy (Assembler module) from the operations performed on it - Checker, Optimizer, and Executor (see tab 11) are three interchangeable Visitor implementations over the same tree, following the classic Interpreter (GoF) structure where grammar = class hierarchy and behavior = external visitor objects. Optimizer&#39;s constant folding is a standard compiler technique layered on top of the same dispatch mechanism." vertex="1">
          <mxGeometry height="100" width="1910" x="40" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="dnKp2-Z0wWQ4jmKkdB9m-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-size: 24px;&quot;&gt;발표에 포함 X (Appendix)&lt;/span&gt;" vertex="1">
          <mxGeometry height="180" width="1250" x="1270" y="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
