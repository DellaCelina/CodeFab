      <mxCell id="DBG_r10" value="+ onStatement(stmt: Statement*, depth: int): void {registered as Executor's statement hook}" style="text;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;html=1;" vertex="1" parent="DBG">
        <mxGeometry y="206" width="320" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="DBG_r11" value="- shouldStop(stmt, depth): bool {Step always stops; Next stops when depth &lt;= recorded depth (step-over); Continue stops on breakpoint via stmt-&gt;containsLine(line)}" style="text;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;html=1;" vertex="1" parent="DBG">
        <mxGeometry y="226" width="320" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="DBG_r12" value="- promptAndHandleCommand(stmt, depth) {reads: step/next/continue/break &lt;line&gt;/watch &lt;name&gt;/inspect}" style="text;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;overflow=hidden;rotatable=0;html=1;" vertex="1" parent="DBG">
        <mxGeometry y="246" width="320" height="20" as="geometry"/>
