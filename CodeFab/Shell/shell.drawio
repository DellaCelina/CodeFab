        <mxCell id="E_DM_Tokenize" value="uses" style="dashed=1;endArrow=open;endFill=0;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="C_DebugMode" target="C_TokenizeInterface">
